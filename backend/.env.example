NODE_ENV=production
PORT=4000
API_BASE_URL=https://staging.cogocity.com
APP_URL=https://staging.cogocity.com

# Required for deployed staging API/database routes.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
REQUIRE_DATABASE=true

# Replace with long random values in the hosting provider. Never commit real secrets.
JWT_ACCESS_SECRET=replace-with-long-random-secret
JWT_REFRESH_SECRET=replace-with-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

CORS_ORIGIN=https://staging.cogocity.com

# Store real Stripe values only as private environment variables in the hosting provider.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_FEE_BPS=1000

# Brevo transactional email. Store real key as a private/secret env var in hosting.
BREVO_API_KEY=
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_FROM=support@cogocity.com
EMAIL_FROM_NAME=CoGoCity

DO_SPACES_BUCKET=cogocity-assets
DO_SPACES_REGION=nyc3
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_CDN_BASE=https://cogocity-assets.nyc3.cdn.digitaloceanspaces.com

# One-time staging import controls for legacy WordPress jobs -> closed community posts.
COGOCITY_IMPORT_LEGACY_CLOSED_JOBS=false
COGOCITY_IMPORT_LEGACY_CLOSED_JOBS_ALLOW_UNMATCHED=false
LEGACY_WORDPRESS_MEDIA_HOST=cogocity.com
LEGACY_WORDPRESS_MEDIA_IP=206.189.191.246
