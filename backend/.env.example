NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# Required for real API/database routes. Leave unset only for first health-check-only deploys.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
REQUIRE_DATABASE=false

# Replace in deployed environments with long random values. Do not reuse these examples.
JWT_ACCESS_SECRET=replace-with-long-random-secret
JWT_REFRESH_SECRET=replace-with-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

CORS_ORIGIN=https://staging.cogocity.com,http://127.0.0.1:8080,http://localhost:8080,file://

# Stripe is intentionally disabled until backend test-mode setup is ready.
# Store real Stripe values only as private environment variables in the hosting provider.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_FEE_BPS=1000

DO_SPACES_BUCKET=cogocity-assets
DO_SPACES_REGION=nyc3
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_CDN_BASE=https://cogocity-assets.nyc3.cdn.digitaloceanspaces.com
