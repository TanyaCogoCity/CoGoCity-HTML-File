generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  student
  employer
  neighbor
  admin
}

enum UserStatus {
  active
  suspended
}

enum JobStatus {
  open
  pending
  closed
}

enum ApplicationStatus {
  applied
  reviewing
  shortlisted
  hired
  rejected
  withdrawn
  offered
  accepted
}

enum ProjectStatus {
  accepted
  funded
  in_progress
  awaiting_approval
  completed
  canceled
}

enum TransactionStatus {
  pending
  funded
  paid
  failed
  refunded
}

enum MessageType {
  user
  system
}

enum NotificationType {
  application
  project
  payment
  message
  workshop
  payout
  refund
  system
}

enum WorkshopFormat {
  online
  in_person
}

enum WorkshopStatus {
  draft
  published
  completed
  canceled
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum MediaAssetType {
  image
  video
}

model User {
  id                            String     @id @default(uuid()) @db.Uuid
  firstName                     String     @map("first_name")
  lastName                      String     @map("last_name")
  displayName                   String     @map("display_name")
  email                         String     @unique
  phone                         String?
  role                          UserRole
  status                        UserStatus @default(active)
  dateOfBirth                   DateTime?  @map("date_of_birth")
  profileImageId                String?    @map("profile_image_id") @db.Uuid
  city                          String?
  passwordHash                  String     @map("password_hash")
  stripeCustomerId              String?    @map("stripe_customer_id")
  stripeDefaultPaymentMethodId  String?    @map("stripe_default_payment_method_id")
  stripePaymentSetupStatus      String     @default("not_started") @map("stripe_payment_setup_status")
  stripeAccountId               String?    @map("stripe_account_id")
  stripeConnectOnboardingStatus String     @default("not_started") @map("stripe_connect_onboarding_status")
  stripeChargesEnabled          Boolean    @default(false) @map("stripe_charges_enabled")
  stripePayoutsEnabled          Boolean    @default(false) @map("stripe_payouts_enabled")
  stripeDetailsSubmitted        Boolean    @default(false) @map("stripe_details_submitted")
  emailVerifiedAt               DateTime?  @map("email_verified_at")
  emailVerificationStatus       String     @default("pending") @map("email_verification_status")
  createdAt                     DateTime   @default(now()) @map("created_at")
  updatedAt                     DateTime   @updatedAt @map("updated_at")
  lastLogin                     DateTime?  @map("last_login")
  deletedAt                     DateTime?  @map("deleted_at")
  reactivationEmailHash         String?    @map("reactivation_email_hash")

  profileImage             MediaAsset?               @relation("UserProfileImage", fields: [profileImageId], references: [id])
  userProfile              UserProfile?
  studentProfiles          StudentProfile[]
  jobsCreated              Job[]                     @relation("JobCreator")
  applications             Application[]             @relation("ApplicationStudent")
  projectsAsEmployer       Project[]                 @relation("ProjectEmployer")
  projectsAsStudent        Project[]                 @relation("ProjectStudent")
  transactionsPaid         Transaction[]             @relation("TransactionPayer")
  transactionsEarned       Transaction[]             @relation("TransactionPayee")
  reviewsWritten           Review[]                  @relation("Reviewer")
  reviewsReceived          Review[]                  @relation("ReviewStudent")
  messagesSent             Message[]                 @relation("MessageSender")
  notifications            Notification[]
  workshopCreated          Workshop[]                @relation("WorkshopCreator")
  workshopEnrollments      WorkshopEnrollment[]
  conversationParticipants ConversationParticipant[]
  refreshTokens            RefreshToken[]
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
  auditLogs                AuditLog[]

  @@map("users")
  @@index([reactivationEmailHash])
}

model UserProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  type            String?
  about           String?
  address         String?
  school          String?
  age             Int?
  avatar          String?
  businessName    String?  @map("business_name")
  businessAbout   String?  @map("business_about")
  businessPhone   String?  @map("business_phone")
  businessAddress String?  @map("business_address")
  businessCity    String?  @map("business_city")
  businessTin     String?  @map("business_tin")
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("user_profiles")
}

model StudentProfile {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  title      String
  bio        String?
  experience String?
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  user     User      @relation(fields: [userId], references: [id])
  services Service[]

  @@index([userId])
  @@map("student_profiles")
}

model Service {
  id           String    @id @default(uuid()) @db.Uuid
  profileId    String    @map("profile_id") @db.Uuid
  title        String
  description  String?
  hourlyRate   Decimal   @map("hourly_rate") @db.Decimal(10, 2)
  availability String?
  location     String?
  isActive     Boolean   @default(true) @map("is_active")
  metadata     Json?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  profile  StudentProfile @relation(fields: [profileId], references: [id])
  reviews  Review[]
  projects Project[]

  @@index([profileId])
  @@map("services")
}

model MediaAsset {
  id           String         @id @default(uuid()) @db.Uuid
  type         MediaAssetType
  url          String
  thumbnailUrl String?        @map("thumbnail_url")
  metadata     Json?
  createdAt    DateTime       @default(now()) @map("created_at")

  usersProfileImage User[]        @relation("UserProfileImage")
  entityLinks       EntityMedia[]

  @@map("media_assets")
}

model EntityMedia {
  id         String  @id @default(uuid()) @db.Uuid
  entityType String  @map("entity_type")
  entityId   String  @map("entity_id")
  mediaId    String  @map("media_id") @db.Uuid
  isPrimary  Boolean @default(false) @map("is_primary")
  sortOrder  Int     @default(0) @map("sort_order")

  media MediaAsset @relation(fields: [mediaId], references: [id])

  @@index([entityType, entityId])
  @@index([mediaId])
  @@map("entity_media")
}

model Job {
  id                      String    @id @default(uuid()) @db.Uuid
  createdBy               String    @map("created_by") @db.Uuid
  title                   String
  description             String?
  category                String?
  hourlyRate              Decimal   @map("hourly_rate") @db.Decimal(10, 2)
  location                String?
  status                  JobStatus @default(open)
  companyName             String?   @map("company_name")
  jobType                 String?   @map("job_type")
  workMode                String?   @map("work_mode")
  compensationText        String?   @map("compensation_text")
  requirements            String?
  schedule                String?
  expiresAt               DateTime? @map("expires_at")
  postingPackage          String?   @map("posting_package")
  postingFee              Decimal?  @map("posting_fee") @db.Decimal(10, 2)
  listingMonths           Int?      @map("listing_months")
  listingDurationDays     Int?      @map("listing_duration_days")
  paymentStatus           String?   @map("payment_status")
  stripeCheckoutSessionId String?   @unique @map("stripe_checkout_session_id")
  stripePaymentIntentId   String?   @unique @map("stripe_payment_intent_id")
  stripeChargeId          String?   @map("stripe_charge_id")
  stripePaymentStatus     String?   @map("stripe_payment_status")
  paidAt                  DateTime? @map("paid_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  deletedAt               DateTime? @map("deleted_at")

  creator      User          @relation("JobCreator", fields: [createdBy], references: [id])
  applications Application[]
  projects     Project[]

  @@index([createdBy, status])
  @@map("jobs")
}

model Application {
  id             String            @id @default(uuid()) @db.Uuid
  jobId          String            @map("job_id") @db.Uuid
  studentId      String            @map("student_id") @db.Uuid
  status         ApplicationStatus @default(applied)
  message        String?
  resumeFileName String?           @map("resume_file_name")
  resumeDataUrl  String?           @map("resume_data_url")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  deletedAt      DateTime?         @map("deleted_at")

  job     Job      @relation(fields: [jobId], references: [id])
  student User     @relation("ApplicationStudent", fields: [studentId], references: [id])
  project Project?

  @@unique([jobId, studentId])
  @@index([jobId, status])
  @@map("applications")
}

model Project {
  id             String        @id @default(uuid()) @db.Uuid
  jobId          String?       @map("job_id") @db.Uuid
  applicationId  String?       @unique @map("application_id") @db.Uuid
  employerId     String        @map("employer_id") @db.Uuid
  studentId      String        @map("student_id") @db.Uuid
  serviceId      String?       @map("service_id") @db.Uuid
  status         ProjectStatus @default(accepted)
  hourlyRate     Decimal       @map("hourly_rate") @db.Decimal(10, 2)
  estimatedHours Int?          @map("estimated_hours")
  actualHours    Int?          @map("actual_hours")
  totalAmount    Decimal?      @map("total_amount") @db.Decimal(10, 2)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  completedAt    DateTime?     @map("completed_at")
  deletedAt      DateTime?     @map("deleted_at")

  job           Job?           @relation(fields: [jobId], references: [id])
  application   Application?   @relation(fields: [applicationId], references: [id])
  employer      User           @relation("ProjectEmployer", fields: [employerId], references: [id])
  student       User           @relation("ProjectStudent", fields: [studentId], references: [id])
  service       Service?       @relation(fields: [serviceId], references: [id])
  transaction   Transaction?
  reviews       Review[]
  conversations Conversation[]

  @@index([employerId, status])
  @@index([studentId, status])
  @@map("projects")
}

model Transaction {
  id                        String            @id @default(uuid()) @db.Uuid
  projectId                 String            @unique @map("project_id") @db.Uuid
  payerId                   String            @map("payer_id") @db.Uuid
  payeeId                   String            @map("payee_id") @db.Uuid
  amountTotal               Decimal           @map("amount_total") @db.Decimal(10, 2)
  platformFee               Decimal           @map("platform_fee") @db.Decimal(10, 2)
  studentPayout             Decimal           @map("student_payout") @db.Decimal(10, 2)
  stripePaymentIntentId      String?           @unique @map("stripe_payment_intent_id")
  stripeChargeId             String?           @map("stripe_charge_id")
  stripeTransferId           String?           @map("stripe_transfer_id")
  stripeApplicationFeeId     String?           @map("stripe_application_fee_id")
  stripeBalanceTransactionId String?           @map("stripe_balance_transaction_id")
  stripeProcessingFee        Decimal?          @map("stripe_processing_fee") @db.Decimal(10, 2)
  platformNetRevenue         Decimal?          @map("platform_net_revenue") @db.Decimal(10, 2)
  transferStatus             String?           @map("transfer_status")
  payoutStatus               String?           @map("payout_status")
  payoutValidationStatus     String?           @map("payout_validation_status")
  payoutValidationCheckedAt DateTime?         @map("payout_validation_checked_at")
  payoutValidationDetails   Json?             @map("payout_validation_details")
  status                    TransactionStatus @default(pending)
  createdAt                 DateTime          @default(now()) @map("created_at")
  updatedAt                 DateTime          @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id])
  payer   User    @relation("TransactionPayer", fields: [payerId], references: [id])
  payee   User    @relation("TransactionPayee", fields: [payeeId], references: [id])

  @@index([payerId, status])
  @@index([payeeId, status])
  @@index([stripeChargeId])
  @@index([stripeTransferId])
  @@index([stripeApplicationFeeId])
  @@map("transactions")
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  reviewerId String   @map("reviewer_id") @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  serviceId  String?  @map("service_id") @db.Uuid
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  project  Project  @relation(fields: [projectId], references: [id])
  reviewer User     @relation("Reviewer", fields: [reviewerId], references: [id])
  student  User     @relation("ReviewStudent", fields: [studentId], references: [id])
  service  Service? @relation(fields: [serviceId], references: [id])

  @@unique([projectId, reviewerId])
  @@index([studentId])
  @@map("reviews")
}

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String?  @map("project_id") @db.Uuid
  label     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project      Project?                  @relation(fields: [projectId], references: [id])
  messages     Message[]
  participants ConversationParticipant[]

  @@index([projectId])
  @@map("conversations")
}

model ConversationParticipant {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  lastReadAt     DateTime? @map("last_read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  senderId       String      @map("sender_id") @db.Uuid
  messageText    String      @map("message_text")
  messageType    MessageType @default(user) @map("message_type")
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation("MessageSender", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false) @map("is_read")
  link      String?
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}

model Workshop {
  id              String         @id @default(uuid()) @db.Uuid
  title           String
  description     String?
  price           Decimal        @db.Decimal(10, 2)
  capacity        Int?
  format          WorkshopFormat
  location        String?
  onlineUrl       String?        @map("online_url")
  durationMinutes Int?           @map("duration_minutes")
  status          WorkshopStatus @default(draft)
  startDate       DateTime       @map("start_date")
  createdBy       String         @map("created_by") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  creator     User                 @relation("WorkshopCreator", fields: [createdBy], references: [id])
  enrollments WorkshopEnrollment[]

  @@index([createdBy, status])
  @@map("workshops")
}

model WorkshopEnrollment {
  id                      String        @id @default(uuid()) @db.Uuid
  workshopId              String        @map("workshop_id") @db.Uuid
  userId                  String        @map("user_id") @db.Uuid
  quantity                Int           @default(1)
  totalAmount             Decimal       @default(0) @map("total_amount") @db.Decimal(10, 2)
  platformFee             Decimal       @default(0) @map("platform_fee") @db.Decimal(10, 2)
  hostPayout              Decimal       @default(0) @map("host_payout") @db.Decimal(10, 2)
  attendeeName            String?       @map("attendee_name")
  attendeeEmail           String?       @map("attendee_email")
  paymentStatus           PaymentStatus @default(pending) @map("payment_status")
  stripeCheckoutSessionId String?       @unique @map("stripe_checkout_session_id")
  stripePaymentIntentId   String?       @unique @map("stripe_payment_intent_id")
  stripeChargeId          String?       @map("stripe_charge_id")
  stripePaymentStatus     String?       @map("stripe_payment_status")
  paidAt                  DateTime?     @map("paid_at")
  createdAt               DateTime      @default(now()) @map("created_at")

  workshop Workshop @relation(fields: [workshopId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([workshopId, userId])
  @@index([stripeChargeId])
  @@map("workshop_enrollments")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@map("audit_logs")
}

model CommunityPost {
  id        String    @id
  authorId  String?   @map("author_id")
  payload   Json
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([authorId])
  @@index([createdAt])
  @@map("community_posts")
}

model SyncRecord {
  entity    String
  recordId  String    @map("record_id")
  payload   Json
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@id([entity, recordId])
  @@index([entity, updatedAt])
  @@map("sync_records")
}
